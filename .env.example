# Secrets never go in git (§12). Copy to .env and fill in.

# Postgres — omit to run with in-memory persistence (state lost on restart)
DATABASE_URL=postgres://shepherd:shepherd@localhost:5432/shepherd

# GitHub: either a token (local dev)...
GITHUB_TOKEN=
# ...or a GitHub App (production: per-installation tokens, higher limits)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Slack bot token (chat:write). Omit to log notifications to the console.
SLACK_BOT_TOKEN=

# External remediation/task service: static bearer token for now; OAuth2
# client-credentials can slot in behind the same adapter later.
REMEDIATION_ENDPOINT=
REMEDIATION_TOKEN=

# Run fully hermetic with in-memory fakes (no network, no DB):
# FAKE_ADAPTERS=1

# Path to the git-JSON policy config (defaults to apps/shepherd/config/shepherd.json)
# SHEPHERD_CONFIG=

PORT=3000
